**/__pycache__/
/.pytest_cache/
pytest-cache-files-*/
/pip/
/venv/

# IDE
/.idea/

# Local ComfyUI runtime caches (HF model snapshots, pip tmp, test fixtures)
/.cache/
**/.cache/
/.test_models/
/.test_input/

# AI assistant scratch (Claude Code / Codex)
/.claude/
/.codex_tmp/

# Local test/tooling laboratory stays optional. Project documentation,
# assistant instructions and persistent memory belong in version control
# (owner's documentation consolidation request, 2026-11-02).
/tests/
/tools/

# Local engineering scratch plans (canonical instructions are tracked).
MODERNIZATION_PLAN.md
comfyui-pack-testing-guide.md

# Historical local working sheets and generators; contributor docs are tracked.
