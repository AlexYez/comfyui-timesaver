   "manifest": "{\n  \"schema_version\": \"1.0.0\",\n  \"id\": \"qwen-image-edit/edit\",\n  \"label\": {\n    \"en\": \"Edit\",\n    \"ru\": \"Редактирование\"\n  },\n  \"family\": \"qwen-image-edit\",\n  \"family_label\": \"Qwen Image Edit\",\n  \"tier\": 2,\n  \"mode\": \"edit\",\n  \"order\": 20,\n  \"controls\": [\n    {\n      \"param\": \"prompt\",\n      \"kind\": \"prompt\",\n      \"superprompt\": true\n    },\n    {\n      \"param\": \"seed\",\n      \"kind\": \"seed\"\n    },\n    {\n      \"param\": \"loras\",\n      \"kind\": \"loras\",\n      \"max\": 8,\n      \"strength\": [\n        -2.0,\n        2.0\n      ]\n    },\n    {\n      \"param\": \"steps\",\n      \"kind\": \"number\",\n      \"advanced\": true,\n      \"min\": 1,\n      \"max\": 60,\n      \"label\": {\n        \"en\": \"Steps\",\n        \"ru\": \"Шаги\"\n      },\n      \"default\": 4\n    },\n    {\n      \"param\": \"cfg\",\n      \"kind\": \"number\",\n      \"advanced\": true,\n      \"min\": 1.0,\n      \"max\": 15,\n      \"step\": 0.1,\n      \"label\": {\n        \"en\": \"CFG\",\n        \"ru\": \"CFG\"\n      },\n      \"default\": 1.0\n    }\n  ],\n  \"refs\": {\n    \"max\": 3\n  },\n  \"requires\": [\n    \"ref_1\"\n  ],\n  \"negative_prompt\": false,\n  \"models\": [\n    {\n      \"title\": \"studio:model\",\n      \"input\": \"unet_name\",\n      \"folder\": \"diffusion_models\",\n      \"match\": \"qwen_image_edit.*(fp8|bf16)|Artius_Qwen_Edit\"\n    },\n    {\n      \"title\": \"studio:clip\",\n      \"input\": \"clip_name\",\n      \"folder\": \"text_encoders\",\n      \"match\": \"qwen_2\\\\.5_vl_7b\"\n    },\n    {\n      \"title\": \"studio:vae\",\n      \"input\": \"vae_name\",\n      \"folder\": \"vae\",\n      \"match\": \"qwen_image_vae\"\n    },\n    {\n      \"title\": \"studio:lora_lightning\",\n      \"match\": \"Qwen-Image-Edit-2511-Lightning-4steps.*bf16\",\n      \"folder\": \"loras\"\n    }\n  ]\n}"
  }
 },
