   "clip": [
    "clip_loader",
    0
   ]
  }
 },
 "multiref": {
  "class_type": "TS_MultiReference",
  "inputs": {
   "conditioning": [
    "encode_pos",
    0
   ],
   "vae": [
    "vae_loader",
    0
   ],
   "max_megapixels": 1.0,
   "divide_by": 64,
   "block_empty_slots": false,
   "mask_orientation": "auto",
