    "encode_pos",
    0
   ]
  }
 },
 "guider": {
  "class_type": "CFGGuider",
  "inputs": {
   "model": [
    "lora_stack",
    0
   ],
   "positive": [
    "multiref",
    3
   ],
   "negative": [
    "neg_zero",
    0
   ],
   "cfg": [
    "p_cfg",
    0
   ]
  }
 },
 "ref_size": {
  "class_type": "GetImageSize",
