   "manifest": "{\"id\": \"flux2-klein/edit\", \"family\": \"flux2-klein\", \"family_label\": \"Flux 2 Klein\", \"mode\": \"edit\", \"order\": 10, \"refs\": {\"max\": 3}, \"requires\": [\"ref_1\"], \"models\": [{\"title\": \"studio:model\", \"input\": \"unet_name\", \"folder\": \"diffusion_models\", \"match\": \"flux.?2.?klein.*(9b|4b)|ArtiusFlux\"}, {\"title\": \"studio:clip\", \"input\": \"clip_name\", \"folder\": \"text_encoders\", \"match\": \"qwen_3_(8b|4b)\"}, {\"title\": \"studio:vae\", \"input\": \"vae_name\", \"folder\": \"vae\", \"match\": \"flux2-vae\"}], \"controls\": [{\"param\": \"prompt\", \"kind\": \"prompt\", \"superprompt\": true}, {\"param\": \"seed\", \"kind\": \"seed\"}, {\"param\": \"loras\", \"kind\": \"loras\", \"max\": 8, \"strength\": [-2.0, 2.0]}, {\"param\": \"steps\", \"kind\": \"number\", \"min\": 1, \"max\": 50, \"step\": 1, \"advanced\": true, \"label\": {\"en\": \"Steps\", \"ru\": \"Шаги\"}}, {\"param\": \"cfg\", \"kind\": \"number\", \"min\": 1.0, \"max\": 10.0, \"step\": 0.1, \"advanced\": true, \"label\": {\"en\": \"CFG\", \"ru\": \"CFG\"}}]}"
  }
 }
