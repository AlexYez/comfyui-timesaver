  "class_type": "TS_StudioManifest",
  "inputs": {
   "manifest": "{\"schema_version\": \"1.0.0\", \"id\": \"z-image/inpaint\", \"label\": {\"en\": \"Inpaint\", \"ru\": \"Inpaint\"}, \"family\": \"z-image\", \"family_label\": \"Z-Image Turbo\", \"mode\": \"inpaint\", \"order\": 30, \"controls\": [{\"param\": \"prompt\", \"kind\": \"prompt\", \"superprompt\": true}, {\"param\": \"seed\", \"kind\": \"seed\"}, {\"param\": \"denoise\", \"kind\": \"slider\", \"min\": 0.1, \"max\": 1.0, \"step\": 0.05, \"label\": {\"en\": \"Repaint strength\", \"ru\": \"Сила перерисовки\"}, \"default\": 1.0}, {\"param\": \"loras\", \"kind\": \"loras\", \"max\": 8, \"strength\": [-2.0, 2.0]}, {\"param\": \"think_steps\", \"kind\": \"number\", \"advanced\": true, \"min\": 1, \"max\": 12, \"label\": {\"en\": \"Think steps (quality)\", \"ru\": \"Шаги размышления (качество)\"}}, {\"param\": \"steps\", \"kind\": \"number\", \"advanced\": true, \"min\": 1, \"max\": 60, \"label\": {\"en\": \"Steps\", \"ru\": \"Шаги\"}}, {\"param\": \"cfg\", \"kind\": \"number\", \"advanced\": true, \"min\": 0, \"max\": 15, \"step\": 0.1, \"label\": {\"en\": \"CFG\", \"ru\": \"CFG\"}}], \"refs\": {\"max\": 0}, \"requires\": [\"source_image\", \"mask\"], \"negative_prompt\": false, \"models\": [{\"title\": \"studio:model\", \"input\": \"unet_name\", \"folder\": \"diffusion_models\", \"match\": \"z.?image.*turbo|Artius_ZImage\"}, {\"title\": \"studio:clip\", \"input\": \"clip_name\", \"folder\": \"text_encoders\", \"match\": \"qwen_3_4b\"}, {\"title\": \"studio:vae\", \"input\": \"vae_name\", \"folder\": \"vae\", \"match\": \"^ae\\\\.safetensors$\"}], \"dependencies\": [{\"pack\": \"LanPaint\", \"nodes\": [\"LanPaint_KSampler\", \"LanPaint_MaskBlend\"]}]}"
  }
