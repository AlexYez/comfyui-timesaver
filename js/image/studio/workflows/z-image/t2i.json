{
 "p_prompt": {
  "class_type": "TS_StudioInputText",
  "inputs": {
   "value": "",
   "param_name": "prompt",
   "label": ""
  }
 },
 "p_width": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1024,
   "param_name": "width",
   "label": ""
  }
 },
 "p_height": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1024,
   "param_name": "height",
   "label": ""
  }
 },
 "p_steps": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 9,
   "param_name": "steps",
   "label": ""
  }
 },
 "p_cfg": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1.0,
   "param_name": "cfg",
   "label": ""
  }
 },
 "p_seed": {
  "class_type": "TS_StudioInputSeed",
  "inputs": {
   "value": 0,
   "param_name": "seed"
  }
 },
 "model_loader": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "zimage\\z_image_turbo_fp8_mixed.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "studio:model"
  }
 },
 "lora_stack": {
  "class_type": "TS_StudioLoraStack",
  "inputs": {
   "model": [
    "model_loader",
    0
   ]
  }
 },
 "clip_loader": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_3_4b.safetensors",
   "type": "lumina2"
  },
  "_meta": {
   "title": "studio:clip"
  }
 },
 "vae_loader": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ae.safetensors"
  },
  "_meta": {
   "title": "studio:vae"
  }
 },
 "encode_pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "p_prompt",
    0
   ],
   "clip": [
    "clip_loader",
    0
   ]
  }
 },
 "neg_zero": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "encode_pos",
    0
   ]
  }
 },
 "model_sampling": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "lora_stack",
    0
   ],
   "shift": 3.0
  }
 },
 "latent": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": [
    "p_width",
    1
   ],
   "height": [
    "p_height",
    1
   ],
   "batch_size": 1
  }
 },
 "sample": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "model_sampling",
    0
   ],
   "seed": [
    "p_seed",
    0
   ],
   "steps": [
    "p_steps",
    1
   ],
   "cfg": [
    "p_cfg",
    0
   ],
   "sampler_name": "dpmpp_2m_sde",
   "scheduler": "beta",
   "positive": [
    "encode_pos",
    0
   ],
   "negative": [
    "neg_zero",
    0
   ],
   "latent_image": [
    "latent",
    0
   ],
   "denoise": 1.0
  }
 },
 "decode": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "sample",
    0
   ],
   "vae": [
    "vae_loader",
    0
   ]
  }
 },
 "studio_out": {
  "class_type": "TS_StudioOutput",
  "inputs": {
   "image": [
    "decode",
    0
   ],
   "filename_prefix": "ts_studio/session"
  }
 },
 "studio_manifest": {
  "class_type": "TS_StudioManifest",
  "inputs": {
   "manifest": "{\n  \"schema_version\": \"1.0.0\",\n  \"id\": \"z-image/t2i\",\n  \"label\": {\n    \"en\": \"Generate\",\n    \"ru\": \"Генерация\"\n  },\n  \"family\": \"z-image\",\n  \"family_label\": \"Z-Image Turbo\",\n  \"tier\": 0,\n  \"mode\": \"t2i\",\n  \"order\": 10,\n  \"controls\": [\n    {\n      \"param\": \"prompt\",\n      \"kind\": \"prompt\",\n      \"superprompt\": true\n    },\n    {\n      \"param\": \"size\",\n      \"kind\": \"size\",\n      \"aspects\": [\n        \"1:1\",\n        \"16:9\",\n        \"9:16\",\n        \"3:2\",\n        \"2:3\",\n        \"4:3\",\n        \"3:4\"\n      ],\n      \"width_param\": \"width\",\n      \"height_param\": \"height\",\n      \"base_mp\": 1.0,\n      \"mp\": [\n        0.25,\n        4.0\n      ],\n      \"snap\": 16\n    },\n    {\n      \"param\": \"seed\",\n      \"kind\": \"seed\"\n    },\n    {\n      \"param\": \"loras\",\n      \"kind\": \"loras\",\n      \"max\": 8,\n      \"strength\": [\n        -2.0,\n        2.0\n      ]\n    },\n    {\n      \"param\": \"steps\",\n      \"kind\": \"number\",\n      \"advanced\": true,\n      \"min\": 1,\n      \"max\": 50,\n      \"step\": 1,\n      \"label\": {\n        \"en\": \"Steps\",\n        \"ru\": \"Шаги\"\n      },\n      \"default\": 9\n    },\n    {\n      \"param\": \"cfg\",\n      \"kind\": \"number\",\n      \"advanced\": true,\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.1,\n      \"label\": {\n        \"en\": \"CFG\",\n        \"ru\": \"CFG\"\n      }\n    }\n  ],\n  \"refs\": {\n    \"max\": 0\n  },\n  \"negative_prompt\": false,\n  \"models\": [\n    {\n      \"title\": \"studio:model\",\n      \"input\": \"unet_name\",\n      \"folder\": \"diffusion_models\",\n      \"match\": \"z.?image.*turbo|Artius_ZImage\"\n    },\n    {\n      \"title\": \"studio:clip\",\n      \"input\": \"clip_name\",\n      \"folder\": \"text_encoders\",\n      \"match\": \"qwen_3_4b\"\n    },\n    {\n      \"title\": \"studio:vae\",\n      \"input\": \"vae_name\",\n      \"folder\": \"vae\",\n      \"match\": \"^ae\\\\.safetensors$\"\n    }\n  ]\n}"
  }
 }
}
