  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1024,
   "param_name": "width",
   "label": ""
  }
 },
 "p_height": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1024,
   "param_name": "height",
   "label": ""
  }
 },
 "p_steps": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 9,
   "param_name": "steps",
   "label": ""
  }
 },
 "p_cfg": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1.0,
   "param_name": "cfg",
   "label": ""
  }
 },
 "p_seed": {
  "class_type": "TS_StudioInputSeed",
  "inputs": {
   "value": 0,
   "param_name": "seed"
  }
 },
 "model_loader": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "zimage\\z_image_turbo_fp8_mixed.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "studio:model"
  }
 },
 "lora_stack": {
  "class_type": "TS_StudioLoraStack",
  "inputs": {
   "model": [
    "model_loader",
    0
   ]
  }
 },
 "clip_loader": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_3_4b.safetensors",
   "type": "lumina2"
  },
  "_meta": {
   "title": "studio:clip"
  }
 },
 "vae_loader": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ae.safetensors"
  },
  "_meta": {
   "title": "studio:vae"
  }
 },
 "encode_pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "p_prompt",
    0
   ],
   "clip": [
    "clip_loader",
    0
   ]
  }
 },
 "neg_zero": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "encode_pos",
    0
   ]
  }
 },
 "model_sampling": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "lora_stack",
    0
   ],
   "shift": 3.0
  }
 },
 "latent": {
  "class_type": "EmptySD3LatentImage",
  "inputs": {
   "width": [
    "p_width",
    1
   ],
   "height": [
    "p_height",
    1
   ],
   "batch_size": 1
  }
 },
 "sample": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "model_sampling",
    0
   ],
   "seed": [
    "p_seed",
    0
   ],
   "steps": [
    "p_steps",
    1
   ],
   "cfg": [
    "p_cfg",
    0
   ],
   "sampler_name": "dpmpp_2m_sde",
   "scheduler": "beta",
   "positive": [
    "encode_pos",
    0
   ],
   "negative": [
    "neg_zero",
    0
   ],
   "latent_image": [
    "latent",
    0
   ],
   "denoise": 1.0
  }
 },
 "decode": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "sample",
    0
   ],
   "vae": [
    "vae_loader",
    0
   ]
  }
 },
 "studio_out": {
  "class_type": "TS_StudioOutput",
  "inputs": {
   "image": [
    "decode",
    0
   ],
   "filename_prefix": "ts_studio/session"
  }
 },
 "studio_manifest": {
  "class_type": "TS_StudioManifest",
  "inputs": {
   "manifest": "{\"schema_version\": \"1.0.0\", \"id\": \"z-image/t2i\", \"label\": {\"en\": \"Generate\", \"ru\": \"Генерация\"}, \"family\": \"z-image\", \"family_label\": \"Z-Image Turbo\", \"mode\": \"t2i\", \"order\": 10, \"controls\": [{\"param\": \"prompt\", \"kind\": \"prompt\", \"superprompt\": true}, {\"param\": \"size\", \"kind\": \"size\", \"aspects\": [\"1:1\", \"16:9\", \"9:16\", \"3:2\", \"2:3\", \"4:3\", \"3:4\"], \"width_param\": \"width\", \"height_param\": \"height\", \"base_mp\": 1.0, \"mp\": [0.25, 4.0], \"snap\": 16}, {\"param\": \"seed\", \"kind\": \"seed\"}, {\"param\": \"loras\", \"kind\": \"loras\", \"max\": 8, \"strength\": [-2.0, 2.0]}, {\"param\": \"steps\", \"kind\": \"number\", \"advanced\": true, \"min\": 1, \"max\": 50, \"step\": 1, \"label\": {\"en\": \"Steps\", \"ru\": \"Шаги\"}, \"default\": 9}, {\"param\": \"cfg\", \"kind\": \"number\", \"advanced\": true, \"min\": 0, \"max\": 15, \"step\": 0.1, \"label\": {\"en\": \"CFG\", \"ru\": \"CFG\"}}], \"refs\": {\"max\": 0}, \"negative_prompt\": false, \"models\": [{\"title\": \"studio:model\", \"input\": \"unet_name\", \"folder\": \"diffusion_models\", \"match\": \"z.?image.*turbo|Artius_ZImage\"}, {\"title\": \"studio:clip\", \"input\": \"clip_name\", \"folder\": \"text_encoders\", \"match\": \"qwen_3_4b\"}, {\"title\": \"studio:vae\", \"input\": \"vae_name\", \"folder\": \"vae\", \"match\": \"^ae\\\\.safetensors$\"}]}"
  }
 }
}