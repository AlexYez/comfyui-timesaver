{
 "p_prompt": {
  "class_type": "TS_StudioInputText",
  "inputs": {
   "value": "",
   "param_name": "prompt",
   "label": ""
  }
 },
 "p_width": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1024,
   "param_name": "width",
   "label": ""
  }
 },
 "p_height": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 1024,
   "param_name": "height",
   "label": ""
  }
 },
 "p_steps": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 28,
   "param_name": "steps",
   "label": ""
  }
 },
 "p_cfg": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 7.0,
   "param_name": "cfg",
   "label": ""
  }
 },
 "p_seed": {
  "class_type": "TS_StudioInputSeed",
  "inputs": {
   "value": 0,
   "param_name": "seed"
  }
 },
 "model_loader": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ideogram\\ideogram4_fp8_scaled.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "studio:model"
  }
 },
 "lora_stack": {
  "class_type": "TS_StudioLoraStack",
  "inputs": {
   "model": [
    "model_loader",
    0
   ]
  }
 },
 "uncond_loader": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "ideogram\\ideogram4_unconditional_fp8_scaled.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "studio:model_uncond"
  }
 },
 "cfg_override": {
  "class_type": "CFGOverride",
  "inputs": {
   "model": [
    "uncond_loader",
    0
   ],
   "cfg": 3.0,
   "start_percent": 0.7,
   "end_percent": 1.0
  }
 },
 "clip_loader": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "ideogram\\qwen3vl_8b_fp8_scaled.safetensors",
   "type": "ideogram4"
  },
  "_meta": {
   "title": "studio:clip"
  }
 },
 "vae_loader": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "flux2\\flux2-vae.safetensors"
  },
  "_meta": {
   "title": "studio:vae"
  }
 },
 "encode_pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "p_prompt",
    0
   ],
   "clip": [
    "clip_loader",
    0
   ]
  }
 },
 "neg_zero": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "encode_pos",
    0
   ]
  }
 },
 "guider": {
  "class_type": "DualModelGuider",
  "inputs": {
   "model": [
    "lora_stack",
    0
   ],
   "positive": [
    "encode_pos",
    0
   ],
   "cfg": [
    "p_cfg",
    0
   ],
   "model_negative": [
    "cfg_override",
    0
   ],
   "negative": [
    "neg_zero",
    0
   ]
  }
 },
 "sampler_sel": {
  "class_type": "KSamplerSelect",
  "inputs": {
   "sampler_name": "euler"
  }
 },
 "sigmas": {
  "class_type": "Ideogram4Scheduler",
  "inputs": {
   "steps": [
    "p_steps",
    1
   ],
   "width": [
    "p_width",
    1
   ],
   "height": [
    "p_height",
    1
   ],
   "mu": 0.0,
   "std": 0.5
  }
 },
 "noise": {
  "class_type": "RandomNoise",
  "inputs": {
   "noise_seed": [
    "p_seed",
    0
   ]
  }
 },
 "latent": {
  "class_type": "EmptyFlux2LatentImage",
  "inputs": {
   "width": [
    "p_width",
    1
   ],
   "height": [
    "p_height",
    1
   ],
   "batch_size": 1
  }
 },
 "sample": {
  "class_type": "SamplerCustomAdvanced",
  "inputs": {
   "noise": [
    "noise",
    0
   ],
   "guider": [
    "guider",
    0
   ],
   "sampler": [
    "sampler_sel",
    0
   ],
   "sigmas": [
    "sigmas",
    0
   ],
   "latent_image": [
    "latent",
    0
   ]
  }
 },
 "decode": {
  "class_type": "VAEDecode",
  "inputs": {
   "samples": [
    "sample",
    0
   ],
   "vae": [
    "vae_loader",
    0
   ]
  }
 },
 "studio_out": {
  "class_type": "TS_StudioOutput",
  "inputs": {
   "image": [
    "decode",
    0
   ],
   "filename_prefix": "ts_studio/session"
  }
 },
 "studio_manifest": {
  "class_type": "TS_StudioManifest",
  "inputs": {
   "manifest": "{\n  \"schema_version\": \"1.0.0\",\n  \"id\": \"ideogram/t2i\",\n  \"label\": {\n    \"en\": \"Generate\",\n    \"ru\": \"Генерация\"\n  },\n  \"family\": \"ideogram\",\n  \"family_label\": \"Ideogram 4\",\n  \"mode\": \"t2i\",\n  \"order\": 15,\n  \"controls\": [\n    {\n      \"param\": \"prompt\",\n      \"kind\": \"prompt\",\n      \"superprompt\": true\n    },\n    {\n      \"param\": \"size\",\n      \"kind\": \"size\",\n      \"aspects\": [\n        \"1:1\",\n        \"16:9\",\n        \"9:16\",\n        \"3:2\",\n        \"2:3\",\n        \"4:3\",\n        \"3:4\"\n      ],\n      \"base_mp\": 1.0,\n      \"mp\": [\n        0.25,\n        2.5\n      ],\n      \"snap\": 16,\n      \"width_param\": \"width\",\n      \"height_param\": \"height\"\n    },\n    {\n      \"param\": \"seed\",\n      \"kind\": \"seed\"\n    },\n    {\n      \"param\": \"loras\",\n      \"kind\": \"loras\",\n      \"max\": 8,\n      \"strength\": [\n        -2.0,\n        2.0\n      ]\n    },\n    {\n      \"param\": \"steps\",\n      \"kind\": \"number\",\n      \"advanced\": true,\n      \"min\": 1,\n      \"max\": 60,\n      \"label\": {\n        \"en\": \"Steps\",\n        \"ru\": \"Шаги\"\n      }\n    },\n    {\n      \"param\": \"cfg\",\n      \"kind\": \"number\",\n      \"advanced\": true,\n      \"min\": 0,\n      \"max\": 15,\n      \"step\": 0.1,\n      \"label\": {\n        \"en\": \"CFG\",\n        \"ru\": \"CFG\"\n      }\n    }\n  ],\n  \"refs\": {\n    \"max\": 0\n  },\n  \"negative_prompt\": false,\n  \"models\": [\n    {\n      \"title\": \"studio:model\",\n      \"input\": \"unet_name\",\n      \"folder\": \"diffusion_models\",\n      \"match\": \"ideogram4_(fp8|int8)(?!.*uncond)\"\n    },\n    {\n      \"title\": \"studio:model_uncond\",\n      \"input\": \"unet_name\",\n      \"folder\": \"diffusion_models\",\n      \"match\": \"ideogram4_unconditional\"\n    },\n    {\n      \"title\": \"studio:clip\",\n      \"input\": \"clip_name\",\n      \"folder\": \"text_encoders\",\n      \"match\": \"qwen3vl_8b\"\n    },\n    {\n      \"title\": \"studio:vae\",\n      \"input\": \"vae_name\",\n      \"folder\": \"vae\",\n      \"match\": \"flux2-vae\"\n    }\n  ]\n}"
  }
 }
}
