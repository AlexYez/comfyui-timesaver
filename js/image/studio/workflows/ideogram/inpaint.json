  "inputs": {
   "manifest": "{\"schema_version\": \"1.0.0\", \"id\": \"ideogram/inpaint\", \"label\": {\"en\": \"Inpaint\", \"ru\": \"Inpaint\"}, \"family\": \"ideogram\", \"family_label\": \"Ideogram 4\", \"mode\": \"inpaint\", \"order\": 30, \"controls\": [{\"param\": \"prompt\", \"kind\": \"prompt\", \"superprompt\": true}, {\"param\": \"seed\", \"kind\": \"seed\"}, {\"param\": \"loras\", \"kind\": \"loras\", \"max\": 8, \"strength\": [-2.0, 2.0]}, {\"param\": \"think_steps\", \"kind\": \"number\", \"advanced\": true, \"min\": 1, \"max\": 12, \"label\": {\"en\": \"Think steps (quality)\", \"ru\": \"Шаги размышления (качество)\"}}, {\"param\": \"steps\", \"kind\": \"number\", \"advanced\": true, \"min\": 1, \"max\": 60, \"label\": {\"en\": \"Steps\", \"ru\": \"Шаги\"}, \"default\": 12}, {\"param\": \"cfg\", \"kind\": \"number\", \"advanced\": true, \"min\": 0, \"max\": 15, \"step\": 0.1, \"label\": {\"en\": \"CFG\", \"ru\": \"CFG\"}}], \"refs\": {\"max\": 0}, \"requires\": [\"source_image\", \"mask\"], \"negative_prompt\": false, \"models\": [{\"title\": \"studio:model\", \"input\": \"unet_name\", \"folder\": \"diffusion_models\", \"match\": \"ideogram4_(fp8|int8)(?!.*uncond)\"}, {\"title\": \"studio:model_uncond\", \"input\": \"unet_name\", \"folder\": \"diffusion_models\", \"match\": \"ideogram4_unconditional\"}, {\"title\": \"studio:clip\", \"input\": \"clip_name\", \"folder\": \"text_encoders\", \"match\": \"qwen3vl_8b\"}, {\"title\": \"studio:vae\", \"input\": \"vae_name\", \"folder\": \"vae\", \"match\": \"flux2.*flux2-vae-v2\"}], \"dependencies\": [{\"pack\": \"LanPaint\", \"nodes\": [\"LanPaint_SamplerCustomAdvanced\", \"LanPaint_MaskBlend\"]}]}"
