{
 "p_image": {
  "class_type": "TS_StudioInputImage",
  "inputs": {
   "value": "",
   "param_name": "source_image",
   "label": ""
  }
 },
 "p_prompt": {
  "class_type": "TS_StudioInputText",
  "inputs": {
   "value": "",
   "param_name": "prompt",
   "label": ""
  }
 },
 "p_seed": {
  "class_type": "TS_StudioInputSeed",
  "inputs": {
   "value": 0,
   "param_name": "seed"
  }
 },
 "p_denoise": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 0.25,
   "param_name": "denoise",
   "label": ""
  }
 },
 "p_steps": {
  "class_type": "TS_StudioInputNumber",
  "inputs": {
   "value": 8,
   "param_name": "steps",
   "label": ""
  }
 },
 "up_loader": {
  "class_type": "UpscaleModelLoader",
  "inputs": {
   "model_name": "4x-ClearRealityV1.pth"
  },
  "_meta": {
   "title": "studio:upscaler"
  }
 },
 "up": {
  "class_type": "ImageUpscaleWithModel",
  "inputs": {
   "upscale_model": [
    "up_loader",
    0
   ],
   "image": [
    "p_image",
    0
   ]
  }
 },
 "model_loader": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "zimage\\z_image_turbo_fp8_mixed.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "studio:model"
  }
 },
 "lora_stack": {
  "class_type": "TS_StudioLoraStack",
  "inputs": {
   "model": [
    "model_loader",
    0
   ]
  }
 },
 "model_sampling": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "lora_stack",
    0
   ],
   "shift": 3.0
  }
 },
 "clip_loader": {
  "class_type": "CLIPLoader",
  "inputs": {
   "clip_name": "qwen_3_4b.safetensors",
   "type": "lumina2"
  },
  "_meta": {
   "title": "studio:clip"
  }
 },
 "vae_loader": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ae.safetensors"
  },
  "_meta": {
   "title": "studio:vae"
  }
 },
 "encode_pos": {
  "class_type": "CLIPTextEncode",
  "inputs": {
   "text": [
    "p_prompt",
    0
   ],
   "clip": [
    "clip_loader",
    0
   ]
  }
 },
 "neg_zero": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "encode_pos",
    0
   ]
  }
 },
 "encode_latent": {
  "class_type": "VAEEncodeTiled",
  "inputs": {
   "pixels": [
    "up",
    0
   ],
   "vae": [
    "vae_loader",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 4096,
   "temporal_overlap": 8
  }
 },
 "sample": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "model_sampling",
    0
   ],
   "seed": [
    "p_seed",
    0
   ],
   "steps": [
    "p_steps",
    1
   ],
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "simple",
   "positive": [
    "encode_pos",
    0
   ],
   "negative": [
    "neg_zero",
    0
   ],
   "latent_image": [
    "encode_latent",
    0
   ],
   "denoise": [
    "p_denoise",
    0
   ]
  }
 },
 "decode": {
  "class_type": "VAEDecodeTiled",
  "inputs": {
   "samples": [
    "sample",
    0
   ],
   "vae": [
    "vae_loader",
    0
   ],
   "tile_size": 512,
   "overlap": 64,
   "temporal_size": 4096,
   "temporal_overlap": 8
  }
 },
 "studio_out": {
  "class_type": "TS_StudioOutput",
  "inputs": {
   "image": [
    "decode",
    0
   ],
   "filename_prefix": "ts_studio/session"
  }
 },
 "studio_manifest": {
  "class_type": "TS_StudioManifest",
  "inputs": {
   "manifest": "{\n  \"schema_version\": \"1.0.0\",\n  \"id\": \"secondpass/upscale\",\n  \"label\": {\n    \"en\": \"Upscale\",\n    \"ru\": \"Апскейл\"\n  },\n  \"family\": \"secondpass\",\n  \"family_label\": \"Diffusion 2-pass (detail)\",\n  \"mode\": \"upscale\",\n  \"order\": 41,\n  \"controls\": [\n    {\n      \"param\": \"prompt\",\n      \"kind\": \"prompt\",\n      \"superprompt\": true\n    },\n    {\n      \"param\": \"seed\",\n      \"kind\": \"seed\"\n    },\n    {\n      \"param\": \"denoise\",\n      \"kind\": \"number\",\n      \"min\": 0.05,\n      \"max\": 0.6,\n      \"step\": 0.05,\n      \"label\": {\n        \"en\": \"Detail denoise\",\n        \"ru\": \"Денойз деталей\"\n      }\n    },\n    {\n      \"param\": \"steps\",\n      \"kind\": \"number\",\n      \"advanced\": true,\n      \"min\": 1,\n      \"max\": 30,\n      \"label\": {\n        \"en\": \"Steps\",\n        \"ru\": \"Шаги\"\n      }\n    }\n  ],\n  \"refs\": {\n    \"max\": 0\n  },\n  \"requires\": [\n    \"source_image\"\n  ],\n  \"upscale_params\": {\n    \"image\": \"source_image\"\n  },\n  \"negative_prompt\": false,\n  \"models\": [\n    {\n      \"title\": \"studio:upscaler\",\n      \"input\": \"model_name\",\n      \"folder\": \"upscale_models\",\n      \"match\": \".\"\n    },\n    {\n      \"title\": \"studio:model\",\n      \"input\": \"unet_name\",\n      \"folder\": \"diffusion_models\",\n      \"match\": \"z.?image.*turbo|Artius_ZImage\"\n    },\n    {\n      \"title\": \"studio:clip\",\n      \"input\": \"clip_name\",\n      \"folder\": \"text_encoders\",\n      \"match\": \"qwen_3_4b\"\n    },\n    {\n      \"title\": \"studio:vae\",\n      \"input\": \"vae_name\",\n      \"folder\": \"vae\",\n      \"match\": \"^ae\\\\.safetensors$\"\n    }\n  ]\n}"
  }
 }
}
